<Application x:Class="RSA_Playfair_NT101.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="UI/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Thứ tự quan trọng: Controls.xaml tham chiếu màu và font của Palette.xaml. -->
                <ResourceDictionary Source="UI/Theme/Palette.xaml" />
                <ResourceDictionary Source="UI/Theme/Controls.xaml" />
                <ResourceDictionary Source="UI/Views/ViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
