<!--
    Vỏ ứng dụng: thanh điều hướng bên trái, nội dung bên phải. Không dùng
    TabControl ở cấp này để mỗi màn hình là một ViewModel độc lập, giữ được trạng
    thái khi người dùng đi qua đi lại.
-->
<Window x:Class="RSA_Playfair_NT101.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RSA_Playfair_NT101.UI.ViewModels"
        Title="RSA &amp; Playfair — NT101"
        Height="800" Width="1280" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20">

                <StackPanel DockPanel.Dock="Top" Margin="14,0,14,20">
                    <TextBlock Text="NT101 · Mật mã học" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="Mã hoá &amp; Chữ ký số" Style="{StaticResource TitleText}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="14,20,14,0"
                           Style="{StaticResource CaptionText}"
                           Text="Bản demo phục vụ học tập. Thuật toán ở đây không có phần đệm ngẫu nhiên nên không dùng cho dữ liệu thật." />

                <ListBox Style="{StaticResource NavList}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="{StaticResource PrimaryTintBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}"
                                               FontSize="11.5" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding SelectedNav.Content}" />
    </Grid>
</Window>
