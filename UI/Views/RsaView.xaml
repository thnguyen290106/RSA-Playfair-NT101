<!--
    Ba tab con đi theo đúng thứ tự một buổi demo: tạo khoá → mã hoá → ký.
    Mỗi tab tự nói giới hạn của mình để người xem tự bấm cũng hiểu.
-->
<UserControl x:Class="RSA_Playfair_NT101.UI.Views.RsaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReadOnlyValue" TargetType="TextBox" BasedOn="{StaticResource MonoBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="MaxHeight" Value="76" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,20">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="RSA" Style="{StaticResource DisplayText}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" MaxWidth="900"
                       HorizontalAlignment="Left"
                       Text="Mã hoá khoá công khai. Khoá công khai (n, e) dùng để mã hoá và xác thực chữ ký; khoá riêng (n, d) dùng để giải mã và ký." />
        </StackPanel>

        <TabControl Style="{StaticResource SubTabControl}" Margin="0,16,0,0">

            <!-- ==================================================== 1. Khoá -->
            <TabItem Header="1 · Khoá">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Margin="0,0,0,10">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Cách tạo khoá" Style="{StaticResource SectionText}" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton GroupName="KeyMode" Style="{StaticResource SegmentChip}"
                                                 Content="Thủ công — tự nhập p, q, e"
                                                 IsChecked="{Binding KeyMode, Converter={StaticResource ValueEquals}, ConverterParameter=Manual}" />
                                    <RadioButton GroupName="KeyMode" Style="{StaticResource SegmentChip}"
                                                 Content="Tự động — sinh số nguyên tố lớn"
                                                 IsChecked="{Binding KeyMode, Converter={StaticResource ValueEquals}, ConverterParameter=Auto}" />
                                </StackPanel>

                                <!-- Thủ công: p, q, e nhập tay. Mặc định 61/53/17 khớp ví dụ giáo trình. -->
                                <StackPanel Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVisible}}">
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="p — số nguyên tố thứ nhất"
                                                       Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                     Text="{Binding ManualP, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="q — số nguyên tố thứ hai"
                                                       Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                     Text="{Binding ManualQ, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="e — số mũ công khai"
                                                       Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                     Text="{Binding ManualE, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                               Text="p và q phải là số nguyên tố và khác nhau. e phải nguyên tố cùng nhau với φ(n) = (p−1)(q−1); để trống thì ứng dụng tự chọn e." />
                                </StackPanel>

                                <!-- Tự động: chọn độ dài khoá. -->
                                <StackPanel Visibility="{Binding IsAutoMode, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="Độ dài khoá n (bit)" Style="{StaticResource FieldLabel}"
                                               Margin="0,14,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <RadioButton GroupName="KeySize" Style="{StaticResource SegmentChip}"
                                                     Content="512"
                                                     IsChecked="{Binding KeySizeBits, Converter={StaticResource ValueEquals}, ConverterParameter=512}" />
                                        <RadioButton GroupName="KeySize" Style="{StaticResource SegmentChip}"
                                                     Content="1024"
                                                     IsChecked="{Binding KeySizeBits, Converter={StaticResource ValueEquals}, ConverterParameter=1024}" />
                                        <RadioButton GroupName="KeySize" Style="{StaticResource SegmentChip}"
                                                     Content="2048"
                                                     IsChecked="{Binding KeySizeBits, Converter={StaticResource ValueEquals}, ConverterParameter=2048}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                               Text="Sinh số nguyên tố bằng Miller–Rabin (40 nhân chứng). Khoá 2048 bit có thể mất vài giây; trong lúc đó cửa sổ vẫn dùng được và có thể bấm Huỷ." />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Tạo khoá" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding GenerateKeyCommand}" />
                                    <Button Content="Huỷ" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Command="{Binding CancelKeyCommand}"
                                            IsEnabled="{Binding IsGeneratingKey}" />
                                    <TextBlock Text="{Binding KeyProgress}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>

                                <!-- Đường thứ ba để có khoá, nằm cùng chỗ với hai đường kia
                                     (nhập tay, sinh tự động). Không đặt ở thẻ "Khoá hiện tại":
                                     thẻ đó lúc chưa có khoá thì không dựng template, nút Tải sẽ
                                     biến mất đúng lúc cần nhất. -->
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Lưu khoá ra file" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Command="{Binding SaveKeyFileCommand}" />
                                    <Button Content="Tải khoá từ file" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Command="{Binding LoadKeyFileCommand}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="privatekey.txt chứa p, q, e — tức là chứa cả khoá riêng. Giữ nó như mật khẩu, đừng gửi cho ai; file để chia sẻ là publickey.txt. Tải lại file này là lấy đúng khoá cũ để giải mã bản mã đã lưu từ lần trước." />

                                <Border Style="{StaticResource DangerBanner}" Margin="0,14,0,0"
                                        Visibility="{Binding KeyError, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Text="{Binding KeyError}" Style="{StaticResource ErrorText}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Khoá hiện tại" Style="{StaticResource SectionText}" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                           Text="Khoá công khai là (n, e) — chia cho mọi người. Khoá riêng là (n, d) — giữ kín. p, q, φ(n) chỉ dùng lúc tạo khoá; ai biết chúng là phá được khoá." />

                                <!-- Chưa tạo khoá thì không hiện sáu ô, để không ai nhìn sáu ô
                                     trống mà tưởng khoá vừa tạo ra là rỗng. Lời nhắc phải bấm
                                     gì nằm ở băng KeyNotes ngay dưới.
                                     Dùng ContentControl chứ không phải Visibility: Content rỗng
                                     là WPF không dựng template, nên sáu binding bên dưới không
                                     tồn tại lúc chưa có khoá. Ẩn bằng Visibility thì chúng vẫn
                                     được tạo và vẫn bám vào một nguồn null → PathError, mà
                                     UiSmokeTests soi trạng thái từng binding nên sẽ đỏ. -->
                                <ContentControl Content="{Binding Key}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <!-- Lề trên nằm ở đây, không nằm ở ContentControl:
                                                 lúc chưa có khoá thì template không dựng nên
                                                 khoảng trắng cũng biến mất theo. -->
                                            <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                                       Text="p (số nguyên tố)" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ReadOnlyValue}"
                                                     Text="{Binding P, Mode=OneWay}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                                       Text="q (số nguyên tố)" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ReadOnlyValue}"
                                                     Text="{Binding Q, Mode=OneWay}" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                                       Text="n = p × q (modulus)" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ReadOnlyValue}"
                                                     Text="{Binding N, Mode=OneWay}" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                                       Text="φ(n) = (p−1)(q−1)" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ReadOnlyValue}"
                                                     Text="{Binding Phi, Mode=OneWay}" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                                       Text="e (số mũ công khai)" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ReadOnlyValue}"
                                                     Text="{Binding E, Mode=OneWay}" />

                                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                                       Text="d = e⁻¹ mod φ(n)" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ReadOnlyValue}"
                                                     Text="{Binding D, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>

                                <Border Style="{StaticResource InfoBanner}" Margin="0,14,0,0"
                                        Visibility="{Binding KeyNotes, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Text="{Binding KeyNotes}" Style="{StaticResource BodyText}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ==================================================== 2. Mã hoá -->
            <TabItem Header="2 · Mã hoá">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Margin="0,0,0,10">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Bản rõ" Style="{StaticResource SectionText}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                                   Text="Văn bản UTF-8, cắt thành từng block nhỏ hơn n." />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Tải bản rõ" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,8"
                                                    Command="{Binding LoadPlainTextFileCommand}" />
                                        </WrapPanel>
                                        <TextBox Style="{StaticResource InputBox}" Height="120" Margin="0,2,0,0"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding PlainText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bản mã (Base64)" Style="{StaticResource SectionText}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                                   Text="Ô này dùng cho cả hai chiều: dán bản mã vào đây rồi bấm Giải mã." />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Lưu bản mã" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,8"
                                                    Command="{Binding SaveCipherFileCommand}" />
                                            <Button Content="Tải bản mã" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,8"
                                                    Command="{Binding LoadCipherFileCommand}" />
                                        </WrapPanel>
                                        <TextBox Style="{StaticResource MonoBox}" Height="120" Margin="0,2,0,0"
                                                 Text="{Binding CipherText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Nút của cột nào nằm dưới cột đó, nên chia lại đúng hai cột. -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0">
                                        <Button Content="Mã hoá bằng (n, e)" Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,8" Command="{Binding EncryptCommand}" />
                                        <Button Content="Giải mã bằng (n, d)" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,8" Command="{Binding DecryptCommand}" />
                                    </WrapPanel>

                                    <WrapPanel Grid.Column="2">
                                        <Button Content="Sao chép bản mã" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,8" Command="{Binding CopyCipherCommand}" />
                                    </WrapPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Bản mã chỉ giải lại được bằng đúng khoá đã mã hoá nó. Khoá sinh tự động mất khi đóng app, nên muốn giải mã lần sau thì lưu khoá ở tab 1 · Khoá." />

                                <TextBlock Text="{Binding CipherFileStatus}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding CipherFileStatus, Converter={StaticResource EmptyToCollapsed}}" />

                                <TextBlock Text="Bản rõ sau khi giải mã" Style="{StaticResource FieldLabel}"
                                           Margin="0,16,0,0" />
                                <TextBox Style="{StaticResource ReadOnlyValue}" Margin="0,6,0,0" MinHeight="46"
                                         Text="{Binding DecryptedText, Mode=OneWay}" />

                                <Border Style="{StaticResource DangerBanner}" Margin="0,8,0,0"
                                        Visibility="{Binding CipherError, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Text="{Binding CipherError}" Style="{StaticResource ErrorText}" />
                                </Border>

                                <TextBlock Text="Xem bản mã dưới dạng" Style="{StaticResource FieldLabel}"
                                           Margin="0,18,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton GroupName="CipherFormat" Style="{StaticResource SegmentChip}"
                                                 Content="Base64"
                                                 IsChecked="{Binding CipherFormat, Converter={StaticResource ValueEquals}, ConverterParameter=Base64}" />
                                    <RadioButton GroupName="CipherFormat" Style="{StaticResource SegmentChip}"
                                                 Content="Hex"
                                                 IsChecked="{Binding CipherFormat, Converter={StaticResource ValueEquals}, ConverterParameter=Hex}" />
                                    <RadioButton GroupName="CipherFormat" Style="{StaticResource SegmentChip}"
                                                 Content="Thập phân (từng block)"
                                                 IsChecked="{Binding CipherFormat, Converter={StaticResource ValueEquals}, ConverterParameter=Decimal}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource ReadOnlyValue}" Margin="0,8,0,0" MaxHeight="120"
                                         MinHeight="46" Text="{Binding CipherView, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="Bản mã gồm 4 byte đầu ghi độ dài bản rõ, sau đó là các block c = mᵉ mod n, mỗi block có độ rộng cố định." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Từng block: m → c = mᵉ mod n"
                                           Style="{StaticResource SectionText}" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                           Text="Bấm Mã hoá để có bảng này. Chọn một dòng để xem chi tiết phép luỹ thừa modulo ở bảng dưới." />

                                <DataGrid Style="{StaticResource TraceGrid}" Margin="0,10,0,0" MaxHeight="190"
                                          ItemsSource="{Binding BlockTraces}"
                                          SelectedItem="{Binding SelectedBlock}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Block" Width="60"
                                                            Binding="{Binding BlockIndex}" />
                                        <DataGridTextColumn Header="Nội dung" Width="180"
                                                            Binding="{Binding PlainPreview}" />
                                        <DataGridTextColumn Header="m (bản rõ dạng số)" Width="*"
                                                            Binding="{Binding PlainValue}" />
                                        <DataGridTextColumn Header="c (bản mã dạng số)" Width="*"
                                                            Binding="{Binding CipherValue}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Bình phương và nhân (square-and-multiply)"
                                           Style="{StaticResource SectionText}" Margin="0,18,0,0" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                           Text="Cách máy tính thật sự tính mᵉ mod n: duyệt e theo từng bit, mỗi bit bình phương một lần và nhân thêm m khi bit bằng 1. Nhờ vậy khoá 1024 bit chỉ cần khoảng 1024 vòng thay vì e vòng." />
                                <TextBlock Text="{Binding ModPowSummary}" Style="{StaticResource MonoText}"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding ModPowSummary, Converter={StaticResource EmptyToCollapsed}}" />

                                <DataGrid Style="{StaticResource TraceGrid}" Margin="0,8,0,0" MaxHeight="240"
                                          ItemsSource="{Binding ModPowSteps}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Bước" Width="60"
                                                            Binding="{Binding StepIndex}" />
                                        <DataGridTextColumn Header="Bit thứ" Width="70"
                                                            Binding="{Binding BitIndex}" />
                                        <DataGridTextColumn Header="Bit" Width="50"
                                                            Binding="{Binding Bit}" />
                                        <DataGridTextColumn Header="Sau bình phương" Width="*"
                                                            Binding="{Binding AfterSquare}" />
                                        <DataGridTextColumn Header="Sau khi nhân m" Width="*"
                                                            Binding="{Binding AfterMultiply}" />
                                        <DataGridTextColumn Header="Giá trị tích luỹ" Width="*"
                                                            Binding="{Binding Accumulator}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ==================================================== 3. Chữ ký -->
            <TabItem Header="3 · Chữ ký số">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Margin="0,0,0,10">

                        <!-- Băng này là điều dễ hiểu sai nhất của tab: viền chạy để hút mắt vào trước. -->
                        <Grid>
                            <Border Style="{StaticResource InfoBanner}">
                                <TextBlock Style="{StaticResource BodyText}"
                                           Text="Ký thì dùng khoá riêng, xác thực thì dùng khoá công khai — ngược với mã hoá. Thông điệp được băm bằng SHA-256 trước, rồi ký trên bản băm: chữ ký = hashᵈ mod n. Vì bản băm dài 256 bit nên khoá phải từ 512 bit trở lên." />
                            </Border>
                            <Rectangle Style="{StaticResource MarchingBorder}" />
                        </Grid>

                        <!--
                            Hai cột = hai bên của một lần ký thật: bên trái có khoá riêng, bên
                            phải chỉ có ba thứ nhận được qua file. Cột phải cố ý không đọc khoá
                            trong bộ nhớ, nếu không thì demo thành một máy tự kiểm lại chính mình.
                        -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ======================================= Cột trái: bên gửi -->
                            <Border Grid.Column="0" Style="{StaticResource Card}"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Bên gửi — dữ liệu gốc"
                                               Style="{StaticResource SectionText}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               Text="Bên này giữ khoá riêng (n, d) và là bên duy nhất ký được." />

                                    <!-- WrapPanel để hàng nút tự xuống dòng khi cửa sổ hẹp. -->
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Tải file" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadMessageFileCommand}" />
                                        <Button Content="Ký số" Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,8" Command="{Binding SignCommand}"
                                                IsEnabled="{Binding CanSign}" />
                                    </WrapPanel>

                                    <TextBlock Text="Thông điệp cần ký" Style="{StaticResource FieldLabel}"
                                               Margin="0,6,0,0" />
                                    <TextBox Style="{StaticResource InputBox}" Height="96" Margin="0,6,0,0"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             Text="{Binding SignMessage, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="SHA-256 của thông điệp" Style="{StaticResource FieldLabel}"
                                               Margin="0,14,0,0" />
                                    <TextBox Style="{StaticResource ReadOnlyValue}" Margin="0,6,0,0" MinHeight="44"
                                             Text="{Binding SignHashHex, Mode=OneWay}" />

                                    <TextBlock Text="Chữ ký số (dạng số thập phân)"
                                               Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                                    <TextBox Style="{StaticResource ReadOnlyValue}" Margin="0,6,0,0" MinHeight="60"
                                             Text="{Binding SignatureText, Mode=OneWay}" />

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Sao chép chữ ký" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,8"
                                                Command="{Binding CopySignatureCommand}" />
                                        <Button Content="Xuất file" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,8"
                                                Command="{Binding ExportSignatureFilesCommand}" />
                                    </WrapPanel>

                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="Xuất file ghi 3 file vào thư mục bạn chọn: filedulieu.signed là file tài liệu, chukyso.txt là chữ ký số, publickey.txt là khoá công khai. Đưa cả 3 file cho bên nhận, không bao giờ đưa khoá riêng." />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                               Text="App chỉ ký được nội dung văn bản: file chọn ở đây được đọc dưới dạng text, không ký file nhị phân." />

                                    <TextBlock Text="{Binding SignFileStatus}" Style="{StaticResource CaptionText}"
                                               Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding SignFileStatus, Converter={StaticResource EmptyToCollapsed}}" />

                                    <Border Style="{StaticResource DangerBanner}" Margin="0,8,0,0"
                                            Visibility="{Binding SignError, Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="{Binding SignError}" Style="{StaticResource ErrorText}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ====================================== Cột phải: bên nhận -->
                            <Border Grid.Column="2" Style="{StaticResource Card}"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Bên nhận — xác minh chữ ký số"
                                               Style="{StaticResource SectionText}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                               Text="Bên này chỉ có 3 thứ: dữ liệu, chữ ký số và khoá công khai. Mỗi ô đều tải được từ file hoặc tự nhập tay." />

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Tải file dữ liệu" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadVerifyMessageFileCommand}" />
                                        <Button Content="Tải chữ ký số" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadVerifySignatureFileCommand}" />
                                        <Button Content="Tải public key" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,8"
                                                Command="{Binding LoadPublicKeyFileCommand}" />
                                    </WrapPanel>

                                    <!-- Nhắc chứ không chặn: người dùng vẫn được tự nhập n và e. -->
                                    <Border Style="{StaticResource WarningBanner}" Margin="0,4,0,0"
                                            Visibility="{Binding VerifyKeyNotice, Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="{Binding VerifyKeyNotice}"
                                                   Style="{StaticResource BodyText}" />
                                    </Border>

                                    <TextBlock Text="n (modulus) của khoá công khai"
                                               Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                    <TextBox Style="{StaticResource MonoBox}" Margin="0,6,0,0" MinHeight="44"
                                             MaxHeight="70"
                                             Text="{Binding VerifyPublicKeyN, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="e (số mũ công khai)" Style="{StaticResource FieldLabel}"
                                               Margin="0,10,0,0" />
                                    <TextBox Style="{StaticResource InputBox}" Margin="0,6,0,0" Width="140"
                                             HorizontalAlignment="Left"
                                             Text="{Binding VerifyPublicKeyE, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Dữ liệu nhận được" Style="{StaticResource FieldLabel}"
                                               Margin="0,14,0,0" />
                                    <TextBox Style="{StaticResource InputBox}" Height="96" Margin="0,6,0,0"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             Text="{Binding VerifyMessage, UpdateSourceTrigger=PropertyChanged}" />

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Băm dữ liệu (SHA-256)"
                                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                                Command="{Binding HashVerifyMessageCommand}" />
                                    </WrapPanel>

                                    <TextBlock Text="Kết quả băm (SHA-256)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource ReadOnlyValue}" Margin="0,6,0,0" MinHeight="44"
                                             Text="{Binding VerifyHashHex, Mode=OneWay}" />

                                    <TextBlock Text="Chữ ký số nhận được" Style="{StaticResource FieldLabel}"
                                               Margin="0,14,0,0" />
                                    <TextBox Style="{StaticResource MonoBox}" Margin="0,6,0,0" MinHeight="60"
                                             MaxHeight="100"
                                             Text="{Binding VerifySignatureText, UpdateSourceTrigger=PropertyChanged}" />

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Giải mã chữ ký" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,8"
                                                Command="{Binding DecryptSignatureCommand}" />
                                    </WrapPanel>

                                    <TextBlock Text="Bản băm lấy lại từ chữ ký: H&#8242; = sᵉ mod n"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource ReadOnlyValue}" Margin="0,6,0,0" MinHeight="44"
                                             Text="{Binding RecoveredHashHex, Mode=OneWay}" />

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Xác minh" Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,8" Command="{Binding VerifyCommand}" />
                                    </WrapPanel>

                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="Chữ ký hợp lệ khi hai ô băm ở trên giống nhau từng ký tự. Sửa một ký tự trong ô dữ liệu rồi băm lại là thấy ngay chữ ký mất hiệu lực." />

                                    <Border Style="{StaticResource DangerBanner}" Margin="0,8,0,0"
                                            Visibility="{Binding VerifyError, Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="{Binding VerifyError}" Style="{StaticResource ErrorText}" />
                                    </Border>

                                    <!--
                                        Một băng duy nhất cho kết quả xác minh, đổi màu theo
                                        VerifyPassed: xanh là hợp lệ, đỏ là không. Chưa bấm
                                        xác minh thì chưa hiện gì.
                                    -->
                                    <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="8"
                                            Padding="14,11"
                                            Visibility="{Binding HasVerified, Converter={StaticResource BoolToVisible}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{StaticResource DangerTintBrush}" />
                                                <Setter Property="BorderBrush" Value="#FECACA" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VerifyPassed}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource SuccessTintBrush}" />
                                                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding VerifyStatus}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VerifyPassed}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
