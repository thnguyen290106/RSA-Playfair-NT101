<!--
    Một màn hình, hai tab: ma trận trước, mã hoá sau — đúng thứ tự phải giải thích
    cho người xem, vì không có ma trận thì không có quy tắc nào để nói.

    Ma trận được định nghĩa một lần trong MatrixTemplate rồi dùng ở cả hai tab: tab 1
    để thấy khoá sinh ra ma trận, tab 2 để thấy cặp đang chọn đi từ ô nào sang ô nào.
-->
<UserControl x:Class="RSA_Playfair_NT101.UI.Views.PlayfairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReadOnlyValue" TargetType="TextBox" BasedOn="{StaticResource MonoBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="MaxHeight" Value="76" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <!-- Ô của ma trận: nền và viền đổi theo trạng thái tô sáng của cặp đang chọn. -->
        <Style x:Key="MatrixCellBox" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Highlight}" Value="In">
                    <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Highlight}" Value="Out">
                    <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Highlight}" Value="Both">
                    <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--
            Ma trận: UniformGrid với số cột lấy từ ViewModel, nên đổi biến thể 5×5 ↔ 6×6
            là tự xếp lại, không cần hai đoạn markup.
        -->
        <DataTemplate x:Key="MatrixTemplate">
            <ItemsControl ItemsSource="{Binding MatrixCells}" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding MatrixColumns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MatrixCellBox}">
                            <TextBlock Text="{Binding Symbol}" Style="{StaticResource MonoText}"
                                       FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Chú thích màu, dùng ở cả hai tab cho khỏi phải đoán màu nào là gì. -->
        <DataTemplate x:Key="MatrixLegendTemplate">
            <TextBlock Style="{StaticResource CaptionText}" Margin="2,8,0,0" TextWrapping="Wrap">
                <Run Text="■" Foreground="{StaticResource PrimaryBrush}" />
                <Run Text="ô của cặp đi vào" />
                <Run Text="   ■" Foreground="{StaticResource AccentBrush}" />
                <Run Text="ô của cặp đi ra" />
                <Run Text="   ■" Foreground="{StaticResource WarningBrush}" />
                <Run Text="vừa vào vừa ra" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="32,26,32,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Playfair" Style="{StaticResource DisplayText}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" MaxWidth="900"
                       Text="Mã hoá thay thế theo từng cặp ký tự trên ma trận chữ sinh từ khoá. Cùng một ma trận dùng cho cả mã hoá và giải mã." />
        </StackPanel>

        <TabControl Style="{StaticResource SubTabControl}" Margin="0,16,0,0">
            <TabItem Header="1 · Ma trận">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Khoá và biến thể" Style="{StaticResource SectionText}" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,12" TextWrapping="Wrap"
                                           Text="Khoá được viết vào ma trận trước, bỏ ký tự lặp và giữ lần xuất hiện đầu; phần còn lại của bảng chữ điền tiếp theo thứ tự." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Biến thể" Style="{StaticResource FieldLabel}" />
                                    <RadioButton GroupName="PlayfairVariant" Style="{StaticResource SegmentChip}"
                                                 Content="5×5 (gộp I/J)"
                                                 IsChecked="{Binding Variant, Converter={StaticResource ValueEquals}, ConverterParameter=Grid5x5MergeIJ}" />
                                    <RadioButton GroupName="PlayfairVariant" Style="{StaticResource SegmentChip}"
                                                 Content="6×6 (chữ và số)"
                                                 IsChecked="{Binding Variant, Converter={StaticResource ValueEquals}, ConverterParameter=Grid6x6Alphanumeric}" />
                                </StackPanel>

                                <TextBlock Text="Khoá" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,10"
                                         Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Khoá sau chuẩn hoá và bỏ ký tự lặp" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding NormalizedKey, Mode=OneWay}" />

                                <Border Style="{StaticResource InfoBanner}" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding VariantNote}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Ma trận" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MatrixTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="2 · Mã hoá và giải mã">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1180" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Văn bản" Style="{StaticResource SectionText}" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,10" TextWrapping="Wrap"
                                           Text="Một ô nhập cho cả hai chiều: bản mã của Playfair vẫn là chữ cái nên không cần tách ô. Bấm 'Đưa kết quả sang ô nhập' để đi vòng ngược." />

                                <TextBox Style="{StaticResource InputBox}" Height="76" Margin="0,0,0,10"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />

                                <WrapPanel>
                                    <Button Content="Mã hoá" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,8" Command="{Binding EncryptCommand}" />
                                    <Button Content="Giải mã" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,8" Command="{Binding DecryptCommand}" />
                                    <Button Content="Đưa kết quả sang ô nhập" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Command="{Binding UseOutputAsInputCommand}" />
                                    <Button Content="Sao chép kết quả" Style="{StaticResource GhostButton}"
                                            Margin="0,0,8,8" Command="{Binding CopyOutputCommand}" />
                                </WrapPanel>

                                <TextBlock Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="{Binding Error}"
                                           Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Kết quả" Style="{StaticResource SectionText}" Margin="0,0,0,10" />

                                <TextBlock Text="Sau chuẩn hoá" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding Normalized, Mode=OneWay}" />

                                <TextBlock Text="Đã chia cặp" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding PairedText, Mode=OneWay}" />

                                <TextBlock Text="{Binding OutputLabel}" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ReadOnlyValue}" Text="{Binding Output, Mode=OneWay}" />

                                <Border Style="{StaticResource WarningBanner}" Margin="0,4,0,0"
                                        Visibility="{Binding WarningText, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               Text="{Binding WarningText}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <!--
                            Bảng vết và ma trận nằm cùng một thẻ: chọn một cặp trong bảng
                            thì phải thấy ngay ô sáng lên, nên hai thứ này không thể ở
                            hai chỗ cách nhau một lần cuộn.
                        -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Vết từng cặp" Style="{StaticResource SectionText}" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,10" TextWrapping="Wrap"
                                           Text="Chọn một dòng để thấy cặp đó đi từ ô nào sang ô nào trên ma trận bên phải. Toạ độ đếm từ 1." />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <DataGrid Grid.Column="0" Style="{StaticResource TraceGrid}" MaxHeight="260"
                                              ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Cặp" Width="46" Binding="{Binding Index}" />
                                            <DataGridTextColumn Header="Vào" Width="52" Binding="{Binding InPair}" />
                                            <DataGridTextColumn Header="Ô vào" Width="110" Binding="{Binding InCells}" />
                                            <DataGridTextColumn Header="Quy tắc" Width="112" Binding="{Binding RuleName}" />
                                            <DataGridTextColumn Header="Ra" Width="52" Binding="{Binding OutPair}" />
                                            <DataGridTextColumn Header="Ô ra" Width="110" Binding="{Binding OutCells}" />
                                            <DataGridCheckBoxColumn Header="Đệm" Width="52" Binding="{Binding FillerInserted}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MatrixTemplate}" />
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MatrixLegendTemplate}" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource InfoBanner}" Margin="0,12,0,0"
                                        Visibility="{Binding StepExplanation, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               Text="{Binding StepExplanation}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
