<!-- Chỗ dành cho Playfair. Chưa cài đặt: nói rõ ra thay vì để trống. -->
<UserControl x:Class="RSA_Playfair_NT101.UI.Views.PlayfairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <StackPanel Margin="32,28,32,32" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="Playfair" Style="{StaticResource DisplayText}" />
        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                   Text="Mã hoá thay thế theo cặp ký tự trên ma trận chữ sinh từ khoá." />

        <Border Style="{StaticResource InfoBanner}" Margin="0,18,0,0">
            <TextBlock Style="{StaticResource BodyText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Phần này chưa được cài đặt. Bản hiện tại tập trung vào RSA — chọn mục RSA ở thanh bên trái." />
        </Border>
    </StackPanel>
</UserControl>
