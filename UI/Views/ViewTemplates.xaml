<!--
    Map ViewModel → View. WPF tự chọn DataTemplate theo kiểu dữ liệu của
    ContentControl.Content, nên phần điều hướng chỉ cần đổi ViewModel là xong,
    không cần navigation service.

    Các converter dùng chung cũng đặt ở đây để mọi View lấy được bằng StaticResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:RSA_Playfair_NT101.UI.Common"
                    xmlns:vm="clr-namespace:RSA_Playfair_NT101.UI.ViewModels"
                    xmlns:views="clr-namespace:RSA_Playfair_NT101.UI.Views">

    <common:ValueEqualsConverter x:Key="ValueEquals" />
    <common:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <views:HomeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PlayfairViewModel}">
        <views:PlayfairView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RsaViewModel}">
        <views:RsaView />
    </DataTemplate>

</ResourceDictionary>
